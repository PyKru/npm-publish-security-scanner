{
  "name": "npm-publish-security-scanner",
  "version": "1.0.0",
  "description": "Pre-publish security scanner for npm packages — detects sourcemap leaks, secrets, and unintended files",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "scripts/",
    "rules/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "scan":             "node scripts/run-all-scans.js",
    "scan:sourcemaps":  "node scripts/scan-sourcemaps.js",
    "scan:secrets":     "node scripts/scan-secrets.js",
    "scan:files":       "node scripts/scan-unintended-files.js",
    "scan:deps":        "node scripts/scan-dependencies.js",
    "prepublishOnly":   "npm run build && npm run scan",
    "build":            "tsc --project tsconfig.json",
    "test":             "jest",
    "prepare":          "is-ci || husky install",
    "lint":             "eslint src --ext .ts,.js",
    "release":          "npm run test && npm run scan && npm publish --provenance"
  },
  "keywords": ["security", "npm", "publish", "scanner", "sourcemap", "secrets", "ci", "devsecops"],
  "engines": { "node": ">=18.0.0", "npm": ">=9.0.0" },
  "devDependencies": {
    "husky": "^9.0.0",
    "is-ci": "^3.0.1",
    "jest": "^29.0.0",
    "typescript": "^5.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "*.{js,ts}": ["eslint --fix", "node scripts/scan-secrets.js"]
  }
}
